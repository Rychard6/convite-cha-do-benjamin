# === Supabase ===
# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Chave anônima (pode ser exposta no client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service role (NUNCA expor no client, usada apenas em Route Handlers/Server Actions)
SUPABASE_SERVICE_ROLE_KEY=

# === Google Sheets ===
# E-mail da service account do Google Cloud com acesso à planilha
GOOGLE_SHEETS_CLIENT_EMAIL=
# Chave privada da service account (mantenha as quebras de linha como \n)
GOOGLE_SHEETS_PRIVATE_KEY=
# ID da planilha (encontrado na URL da planilha)
GOOGLE_SHEETS_SPREADSHEET_ID=

# === Evento ===
# Endereço completo exibido na tela "Como chegar"
NEXT_PUBLIC_EVENT_ADDRESS="Rua das Flores, 123 - Jardim das Árvores, Brasília - DF"
# Link do Google Maps com a localização do evento
NEXT_PUBLIC_GOOGLE_MAPS_URL="https://maps.google.com/?q=Rua+das+Flores+123"
# Link do Waze com a localização do evento
NEXT_PUBLIC_WAZE_URL="https://waze.com/ul?q=Rua%20das%20Flores%20123"
